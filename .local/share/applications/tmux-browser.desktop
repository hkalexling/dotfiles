[Desktop Entry]
Version=1.0
Name=tmux-browser
GenericName=Web Browser
Comment=tmux-like Wayland compositor hosting browser panels
Exec=tmux-browser %U
Terminal=false
Icon=web-browser
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;application/xhtml_xml;image/gif;image/jpeg;image/png;image/webp;application/pdf;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
StartupNotify=true
StartupWMClass=tmux-browser
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=tmux-browser --new-window
