+
+test("drops an interrupted turn so its unfinished tool call is not replayed", () => {
+  // A real shape: Esc landed while the model emitted a bash call, so the saved assistant turn
+  // carries a tool call with no result. Replaying it made every later request fail with
+  // "`tool_use` ids were found without `tool_result` blocks immediately after".
+  const model = { id: "sonnet", api: "claude-code-stream-json", provider: "claude-code", input: ["text", "image"] } as unknown as Model<any>;
+  const answered: AssistantMessage = {
+    role: "assistant",
+    api: model.api,
+    provider: model.provider,
+    model: model.id,
+    content: [{ type: "text", text: "listing" }, { type: "toolCall", id: "t1", name: "bash", arguments: { command: "ls" } }],
+    usage,
+    stopReason: "toolUse",
+    timestamp: 1,
+  };
+  const interrupted: AssistantMessage = {
+    role: "assistant",
+    api: model.api,
+    provider: model.provider,
+    model: model.id,
+    content: [{ type: "thinking", thinking: "planning the next step", thinkingSignature: "signed" }, { type: "toolCall", id: "t2", name: "bash", arguments: {} }],
+    usage,
+    stopReason: "aborted",
+    timestamp: 2,
+  };
+  const messages: Message[] = [
+    { role: "user", content: "go", timestamp: 0 },
+    answered,
+    { role: "toolResult", toolCallId: "t1", toolName: "bash", content: [{ type: "text", text: "a" }], isError: false, timestamp: 3 },
+    interrupted,
+    { role: "user", content: "continue", timestamp: 4 },
+  ];
+  const original = structuredClone(messages);
+
+  const prepared = prepareMessages(messages, model);
+  assert.equal(prepared.some((message) => message.role === "assistant" && message.stopReason === "aborted"), false);
+  assertBalancedFrames(prepareFrames(prepared));
+  assert.deepEqual(messages, original);
+});
+
+test("answers a replayed tool call that has no result before the next user turn", () => {
+  const model = { id: "sonnet", api: "claude-code-stream-json", provider: "claude-code", input: ["text", "image"] } as unknown as Model<any>;
+  const assistant: AssistantMessage = {
+    role: "assistant",
+    api: model.api,
+    provider: model.provider,
+    model: model.id,
+    content: [{ type: "toolCall", id: "t1", name: "read", arguments: { path: "a" } }, { type: "toolCall", id: "t2", name: "read", arguments: { path: "b" } }],
+    usage,
+    stopReason: "toolUse",
+    timestamp: 1,
+  };
+  const messages: Message[] = [
+    { role: "user", content: "read both", timestamp: 0 },
+    assistant,
+    { role: "toolResult", toolCallId: "t1", toolName: "read", content: [{ type: "text", text: "A" }], isError: false, timestamp: 2 },
+    { role: "user", content: "and now?", timestamp: 3 },
+  ];
+  const original = structuredClone(messages);
+
+  const prepared = prepareMessages(messages, model);
+  const synthetic = prepared.find((message) => message.role === "toolResult" && message.toolCallId === "t2");
+  assert.ok(synthetic);
+  assert.equal(synthetic.role, "toolResult");
+  if (synthetic.role === "toolResult") {
+    assert.equal(synthetic.isError, true);
+    assert.equal(synthetic.toolName, "read");
+    assert.deepEqual(synthetic.content, [{ type: "text", text: "No result provided" }]);
+  }
+  assert.ok(prepared.indexOf(synthetic) < prepared.length - 1, "the answer precedes the next user turn");
+  assert.equal(prepared.filter((message) => message.role === "toolResult").length, 2, "an answered call is not answered twice");
+  assertBalancedFrames(prepareFrames(prepared));
+  assert.deepEqual(messages, original);
+});
+
+test("holds a system message until a turn's tool results are complete", () => {
+  const model = { id: "sonnet", api: "claude-code-stream-json", provider: "claude-code", input: ["text", "image"] } as unknown as Model<any>;
+  const assistant: AssistantMessage = {
+    role: "assistant",
+    api: model.api,
+    provider: model.provider,
+    model: model.id,
+    content: [{ type: "toolCall", id: "t1", name: "read", arguments: { path: "a" } }],
+    usage,
+    stopReason: "toolUse",
+    timestamp: 1,
+  };
+  const messages: Message[] = [
+    { role: "user", content: "read", timestamp: 0 },
+    assistant,
+    { role: "system", content: [{ type: "text", text: "tools changed" }], timestamp: 2 },
+    { role: "toolResult", toolCallId: "t1", toolName: "read", content: [{ type: "text", text: "A" }], isError: false, timestamp: 3 },
+    { role: "user", content: "next", timestamp: 4 },
+  ];
+  const prepared = prepareMessages(messages, model);
+  const roles = prepared.map((message) => message.role);
+  assert.deepEqual(roles, ["user", "assistant", "toolResult", "system", "user"]);
+  assertBalancedFrames(prepareFrames(prepared));
+});
+
+function assertBalancedFrames(frames: ReturnType<typeof prepareFrames>): void {
+  const calls = new Set<string>();
+  const results = new Set<string>();
+  for (const frame of frames) {
+    for (const block of frame.message.content as Array<Record<string, unknown>>) {
+      if (block.type === "tool_use") calls.add(String(block.id));
+      if (block.type === "tool_result") results.add(String(block.tool_use_id));
+    }
+  }
+  assert.deepEqual([...calls].sort(), [...results].sort(), "every replayed tool_use needs exactly one tool_result");
+}
