+
+/**
+ * Replay-safe second pass, matching what pi-ai's transformMessages does for the built-in
+ * providers. Extensions cannot import `pi-ai/api/*` (the loader maps only the root and a few
+ * subpaths), so the rule is restated here.
+ *
+ * An interrupted turn leaves an assistant message that holds a tool call with no result. Pi
+ * keeps that message, and prepareFrames would replay it as `tool_use` with a plain user message
+ * where the `tool_result` belongs, so Anthropic rejects the request:
+ * "`tool_use` ids were found without `tool_result` blocks immediately after ...". Because that
+ * history is replayed on every later turn, the session is then stuck (issue #49).
+ *
+ * So: never replay an incomplete turn (`stopReason` "error" or "aborted"), and answer every tool
+ * call that has no result with an error tool result at the point where its turn ends.
+ */
+function closeOrphanedToolCalls(messages: Message[]): Message[] {
+  const output: Message[] = [];
+  let pending: ToolCall[] = [];
+  let answered = new Set<string>();
+  // A system message that lands between a tool call and its results must not end the turn, so it
+  // waits for the results, synthetic ones included, and is emitted after them.
+  const heldSystemMessages: Message[] = [];
+
+  const closePending = () => {
+    for (const call of pending) {
+      if (answered.has(call.id)) continue;
+      output.push({
+        role: "toolResult",
+        toolCallId: call.id,
+        toolName: call.name,
+        content: [{ type: "text", text: "No result provided" }],
+        isError: true,
+        timestamp: Date.now(),
+      } satisfies ToolResultMessage);
+    }
+    pending = [];
+    answered = new Set<string>();
+    output.push(...heldSystemMessages);
+    heldSystemMessages.length = 0;
+  };
+
+  for (const message of messages) {
+    if (message.role === "assistant") {
+      // Whatever turn came before ends here, so its unanswered calls are answered now.
+      closePending();
+      if (message.stopReason === "error" || message.stopReason === "aborted") continue;
+      const calls = message.content.filter((block) => block.type === "toolCall");
+      if (calls.length > 0) {
+        pending = calls;
+        answered = new Set<string>();
+      }
+      output.push(message);
+    } else if (message.role === "toolResult") {
+      answered.add(message.toolCallId);
+      output.push(message);
+    } else if (message.role === "system") {
+      if (pending.length > 0) heldSystemMessages.push(message);
+      else output.push(message);
+    } else {
+      // A user turn, like the end of the history, closes the tool flow of the turn before it.
+      if (message.role === "user") closePending();
+      output.push(message);
+    }
+  }
+  closePending();
+  return output;
 }
 
