{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap"
    ],
    "modules-right": [
        "custom/screenrec",
        "network",
        "disk",
        "battery",
        "clock",
        "custom/local",
        "custom/utc",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        "disable-scroll": false,
        "all-outputs": true,
        "on-click": "activate"
    },
    "hyprland/submap": {
        "format": "MODE: {}",
        "always-on": false,
        "tooltip": false
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "lan: {ipaddr}",
        "format-disconnected": "no wlan"
    },
    "disk": {
        "format": "⛁ {free} ({percentage_free}%)",
        "path": "/"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}% ({time})",
        "format-charging": "⚡ {capacity}%",
        "format-full": "☻ {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "format": "{:%b %d %a}"
    },
    "custom/local": {
        "exec": "~/.config/waybar/local.sh",
        "interval": 60,
        "return-type": "json"
    },
    "custom/hkt": {
        "exec": "~/.config/waybar/hkt.sh",
        "interval": 60,
        "return-type": "json"
    },
    "custom/utc": {
        "exec": "~/.config/waybar/utc.sh",
        "interval": 60,
        "return-type": "json"
    },
    "custom/screenrec": {
        "exec": "~/.config/waybar/screenrec.sh",
        "interval": 1,
        "return-type": "json",
        "on-click": "~/.config/hypr/scripts/record-toggle.sh",
        "tooltip": true
    },
    "tray": {
        "spacing": 10
    }
}
