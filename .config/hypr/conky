conky.config = {
	out_to_wayland = true,
	out_to_x = false,
	alignment = 'top_right',
	color2 = '5D7B86',
	cpu_avg_samples = 2,
	default_color = 'F9FAF9',
	font = 'Bitstream Vera Sans:size=8',
	draw_shades = false,
	gap_x = 35,
	gap_y = 35,
	minimum_width = 200,
	no_buffers = true,
	own_window = true,
	own_window_type = 'desktop',
	own_window_transparent = true,
	update_interval = 3.0,
	use_xft = true,
}
conky.text = [[
${voffset 8}$color2${font Bitstream Vera Sans:size=16}${time %A}$font\
${voffset -8}$alignr$color${font Bitstream Vera Sans:size=38}${time %e}$font
$color${voffset -30}$color${font Bitstream Vera Sans:size=18}${time %b}$font\
${voffset -3} $color${font Bitstream Vera Sans:size=20}${time %Y}$font$color2$hr
#
${voffset 20}${offset 40}${color}CPU / ${exec cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor}${font Bitstream Vera Sans:bold:size=8}$alignr$cpu%
${voffset 5}${offset 40}$font$color2${top name 1}$alignr$color${top cpu 1}%
${offset 40}$color2${top name 2}$alignr$color${top cpu 2}%
${offset 40}$color2${top name 3}$alignr$color${top cpu 3}%
${offset 40}$color2${top name 4}$alignr$color${top cpu 4}%
# ${offset 40}$color2${top name 5}$alignr$color${top cpu 5}%
#
${voffset 10}${offset 40}${color}RAM${font Bitstream Vera Sans:bold:size=8}$alignr$mem$font
${offset 40}${voffset 5}$color2${top_mem name 1}$alignr$color${top_mem mem_res 1}
${offset 40}$color2${top_mem name 2}$alignr$color${top_mem mem_res 2}
${offset 40}$color2${top_mem name 3}$alignr$color${top_mem mem_res 3}
${offset 40}$color2${top_mem name 4}$alignr$color${top_mem mem_res 4}
# ${offset 40}$color2${top_mem name 5}$alignr$color${top_mem mem_res 5}
#
${voffset 10}${offset 40}${color}Swap${font Bitstream Vera Sans:bold:size=8}$alignr${swap}/ ${swapfree}$font
${voffset 10}${offset 40}${color}Disk${font Bitstream Vera Sans:bold:size=8}$alignr${fs_bar 5,50 /}   ${fs_used /}$font
#${voffset 15}$font$alignr${execi 10000 awk -F= '/TION/ {print $2}' /etc/lsb-release |sed 's/"//g'} \
#${execi 10000 awk -F= '/EASE=/ {printf $2" "} /NAME/ {print $2}' /etc/lsb-release}
${voffset 10}
${alignr}${color2}${font Bitstream Vera Sans:size=8}Uptime: ${color}${uptime_short}
${color2}${font Bitstream Vera Sans:size=8}${alignr}Kernel: ${color}${kernel}
]]
